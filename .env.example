# ============================================================
#  Airstrike BTC Kawa — Environment Configuration
# ============================================================

# ─── MetaTrader 5 Credentials ────────────────────────────
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=YourPasswordHere
MT5_SERVER=YourBroker-MT5Server

# ─── MT5 Install Path ───────────────────────────────────
MT5_INSTALL_PATH=C:\Program Files\Exness MT5 Terminal

# ─── Telegram Bot Configuration ─────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USERS=123456789,987654321

# ─── Trade Parameters ──────────────────────────────
BOT_ACTIVE=True
TRADE_SYMBOL=BTCUSD
TRADE_LOTS=0.01
POLY_BET_SIZE=2.50
SL_PIPS=700
TP_PIPS=200
TRADE_COOLDOWN_SECONDS=60
MAX_TRADES_PER_HOUR=3
MAX_NEWS_AGE_SECONDS=180

# ─── Gemini AI (required for classification) ───────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Gemini Model Selection ─────────────────────────────
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ─── AI Cooldown (seconds) ───────────────────────────
AI_COOLDOWN_SECONDS=10

# ─── Polymarket Configuration ──────────────────────────────
POLY_PRIVATE_KEY=your_poly_private_key_here
POLY_FUNDER_ADDRESS=your_poly_funder_address_here
POLY_API_KEY=your_poly_api_key_here
POLY_API_SECRET=your_poly_api_secret_here
POLY_API_PASSPHRASE=your_poly_api_passphrase_here
BUILDER_CODE=your_builder_code_here

# ─── Optional News APIs (scrapers work without these) ──────
FINNHUB_API_KEY=your_finnhub_key_here
